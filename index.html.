<!DOCTYPE html>
<html lang="es">
<head>
<link rel="icon" type="image/png" href="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/items/poke-ball.png">   
<meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PokéWeb Global - Multilingüe Pro</title>
    <style>
        :root {
            --pokedex-red: #dc0a2d;
            --pokedex-dark-red: #9e0820;
            --screen-green: #8df09d;
            --screen-dark-green: #0b240f;
            --dark-bg: #1e293b;
            --card-bg: #334155;
            --shiny-gold: #ffcc00;
            --regional-purple: #a855f7;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #0f172a;
            color: #f8fafc;
            min-height: 100vh;
        }

        /* BARRA DE NAVEGACIÓN */
        nav {
            background-color: var(--pokedex-dark-red);
            padding: 15px 30px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 4px solid #232323;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
        }

        nav .logo {
            font-size: 1.5rem;
            font-weight: bold;
            letter-spacing: 2px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        nav .logo-ball {
            width: 25px;
            height: 25px;
            background: white;
            border-radius: 50%;
            border: 3px solid #232323;
            position: relative;
        }
        nav .logo-ball::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 100%;
            height: 3px;
            background: #232323;
        }

        /* SELECCIÓN DE IDIOMA */
        .lang-selector {
            padding: 6px 12px;
            font-size: 0.9rem;
            border-radius: 6px;
            border: 2px solid #232323;
            background-color: white;
            color: #232323;
            font-weight: bold;
            outline: none;
            cursor: pointer;
        }

        /* ENCABEZADO */
        .header-container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 30px 20px 10px 20px;
            text-align: center;
        }

        .header-container h1 {
            font-size: 2.5rem;
            margin-bottom: 15px;
            color: var(--shiny-gold);
            text-shadow: 2px 2px #232323;
        }

        .pokedex-definition-box {
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            border: 2px solid var(--pokedex-red);
            border-left: 8px solid var(--pokedex-red);
            padding: 20px;
            border-radius: 8px;
            text-align: left;
            max-width: 900px;
            margin: 15px auto 25px auto;
            box-shadow: 0 6px 15px rgba(0,0,0,0.4);
        }

        .pokedex-definition-box h2 {
            font-size: 1.2rem;
            color: white;
            margin-bottom: 8px;
            text-transform: uppercase;
        }

        .pokedex-definition-box p {
            font-size: 0.95rem;
            line-height: 1.6;
            color: #94a3b8;
        }

        /* CONTENEDOR INTERACTIVO */
        .web-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 20px 20px 20px;
            display: grid;
            grid-template-columns: 390px 1fr;
            gap: 30px;
        }

        @media (max-width: 950px) {
            .web-container { grid-template-columns: 1fr; }
            .pokedex-device { position: relative !important; top: 0 !important; }
        }

        /* DISPOSITIVO POKÉDEX */
        .pokedex-device {
            background-color: var(--pokedex-red);
            border: 4px solid #232323;
            border-radius: 20px;
            padding: 20px;
            height: fit-content;
            position: sticky;
            top: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }

        .top-lights { display: flex; align-items: center; margin-bottom: 15px; }
        .big-blue-light {
            width: 45px; height: 45px; background-color: #00bfff;
            border: 4px solid white; border-radius: 50%;
            box-shadow: 0 0 10px #00bfff; margin-right: 15px;
        }
        .small-light { width: 12px; height: 12px; border-radius: 50%; margin-right: 8px; border: 1px solid #232323; }
        .red { background-color: #ff0000; }
        .yellow { background-color: #ffcc00; }
        .green { background-color: #00ff00; }

        .search-bar {
            width: 100%; padding: 12px; border: 3px solid #232323;
            border-radius: 8px; font-size: 1rem; margin-bottom: 15px; outline: none;
        }

        .screen-container {
            background-color: #ededed; border: 4px solid #232323;
            border-radius: 10px 10px 10px 40px; padding: 15px; margin-bottom: 15px;
        }

        .screen {
            background-color: #232323; border-radius: 5px;
            padding: 15px; text-align: center; min-height: 220px;
            display: flex; flex-direction: column; justify-content: center;
            align-items: center; position: relative;
        }

        .screen img { width: 150px; height: 150px; object-fit: contain; }
        .screen .name { font-size: 1.1rem; color: #4dad5b; font-family: monospace; margin-top: 10px; text-transform: uppercase; text-align: center; max-width: 90%; word-wrap: break-word;}

        .shiny-indicator {
            position: absolute; top: 10px; right: 10px; font-size: 1.4rem;
            color: var(--shiny-gold); display: none; text-shadow: 0 0 8px var(--shiny-gold);
        }

        /* CONTROLES */
        .gender-container {
            display: flex; gap: 10px; margin-bottom: 10px;
        }

        .btn-control {
            flex: 1; padding: 10px; background-color: #232323;
            color: white; border: 2px solid #fff; border-radius: 8px;
            font-weight: bold; cursor: pointer; text-transform: uppercase;
            transition: all 0.2s ease; font-size: 0.9rem;
            display: flex; justify-content: center; align-items: center; gap: 5px;
        }
        .btn-control:hover:not(:disabled) { background-color: #444; }
        
        .btn-control:disabled {
            background-color: #4b5563 !important;
            color: #9ca3af !important;
            border-color: #374151 !important;
            cursor: not-allowed !important;
            box-shadow: none !important;
        }

        .btn-control.active-male { background-color: #3b82f6; border-color: #232323; color: white; }
        .btn-control.active-female { background-color: #ec4899; border-color: #232323; color: white; }
        .btn-control.active-shiny { background-color: var(--shiny-gold); border-color: #232323; color: #232323; }
        .btn-control.active-regional { background-color: var(--regional-purple); border-color: #232323; color: white; }

        /* PANTALLA LCD */
        .info-screen {
            background-color: var(--screen-green);
            border: 4px solid #232323;
            border-radius: 8px;
            padding: 15px;
            font-family: 'Courier New', Courier, monospace;
            color: var(--screen-dark-green);
            box-shadow: inset 0 0 10px rgba(0,0,0,0.5);
        }

        .stats-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 6px 12px;
            font-size: 0.85rem;
            font-weight: bold;
            border-bottom: 2px solid rgba(11, 36, 15, 0.3);
            padding-bottom: 8px;
            margin-bottom: 10px;
        }

        .stats-label {
            color: rgba(11, 36, 15, 0.7);
            text-transform: uppercase;
        }

        /* Caja de descripción */
        .description-box {
            background-color: rgba(11, 36, 15, 0.06);
            border: 1px solid rgba(11, 36, 15, 0.15);
            border-radius: 6px;
            padding: 10px;
            font-size: 0.9rem;
            line-height: 1.5;
            text-align: left;
            min-height: 110px;
            word-wrap: break-word;
        }

        /* COLUMNA DERECHA: GRID */
        .pokemon-grid-container { display: flex; flex-direction: column; gap: 20px; }
        .grid-header {
            font-size: 1.5rem; border-bottom: 2px solid var(--card-bg);
            padding-bottom: 10px; color: var(--shiny-gold);
            display: flex; justify-content: space-between; align-items: center;
        }
        .grid-header span { font-size: 0.9rem; color: #64748b; }

        .pokemon-grid {
            display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
            gap: 15px; height: 650px; overflow-y: auto; padding-right: 10px;
        }
        .pokemon-grid::-webkit-scrollbar { width: 8px; }
        .pokemon-grid::-webkit-scrollbar-track { background: #0f172a; }
        .pokemon-grid::-webkit-scrollbar-thumb { background: var(--card-bg); border-radius: 4px; }

        .poke-card {
            background-color: var(--card-bg); border: 2px solid transparent;
            border-radius: 12px; padding: 12px; text-align: center;
            cursor: pointer; transition: transform 0.2s, border-color 0.2s;
        }
        .poke-card:hover { transform: translateY(-4px); border-color: var(--shiny-gold); }
        .poke-card img { width: 85px; height: 85px; object-fit: contain; }
        .poke-card p { font-size: 0.8rem; color: #94a3b8; font-weight: bold; }
        .poke-card h3 { font-size: 0.95rem; text-transform: capitalize; margin-top: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

        footer {
            text-align: center; padding: 25px; margin-top: 40px;
            background-color: #020617; color: #64748b; font-size: 0.9rem;
            border-top: 4px solid var(--pokedex-dark-red);
        }
    </style>
</head>
<body>

    <nav>
        <div class="logo"><div class="logo-ball"></div> POKÉWEB GLOBAL</div>
        <select id="lang-select" class="lang-selector">
            <option value="es">Español</option>
            <option value="en">English</option>
            <option value="fr">Français</option>
            <option value="de">Deutsch</option>
            <option value="ja">日本語</option>
        </select>
    </nav>

    <div class="header-container">
        <h1 id="main-title">Base de Datos Pokémon</h1>
        <div class="pokedex-definition-box">
            <h2 id="def-title">🔴 ¿Qué es una Pokédex?</h2>
            <p id="def-desc">La <strong>Pokédex</strong> es una enciclopedia electrónica portátil e inteligente diseñada para recolectar, analizar y almacenar información sobre las diferentes especies de Pokémon del mundo. Escanea los rasgos biológicos de las criaturas y organiza automáticamente datos fundamentales como su número de identificación nacional, descripción biológica de su hábitat, tipos elementales, peso y altura oficiales.</p>
        </div>
    </div>

    <div class="web-container">
        
        <aside class="pokedex-device">
            <div class="top-lights">
                <div class="big-blue-light"></div>
                <div class="small-light red"></div>
                <div class="small-light yellow"></div>
                <div class="small-light green"></div>
            </div>

            <input type="text" id="search-input" class="search-bar" placeholder="Buscar por nombre o ID...">

            <div class="screen-container">
                <div class="screen">
                    <div id="shiny-stars" class="shiny-indicator">✨</div>
                    <img id="poke-img" src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/1.png" alt="Pokemon">
                    <div id="poke-name" class="name">bulbasaur N°.001</div>
                </div>
            </div>

            <div class="gender-container">
                <button id="btn-male" class="btn-control active-male">♂ Macho</button>
                <button id="btn-female" class="btn-control">♀ Hembra</button>
            </div>
            <div class="gender-container">
                <button id="shiny-toggle" class="btn-control">✨ Shiny</button>
                <button id="regional-toggle" class="btn-control" disabled>🗺️ Región</button>
            </div>

            <div class="info-screen">
                <div class="stats-grid">
                    <div><span class="stats-label" id="lbl-t-type">TIPO:</span> <span id="lbl-type">GRASS</span></div>
                    <div><span class="stats-label">ID:</span> <span id="lbl-id">#001</span></div>
                    <div><span class="stats-label" id="lbl-t-height">ALT:</span> <span id="lbl-height">0.7 m</span></div>
                    <div><span class="stats-label" id="lbl-t-weight">PESO:</span> <span id="lbl-weight">6.9 kg</span></div>
                    <div style="grid-column: span 2;"><span class="stats-label" id="lbl-t-gen">GENERACIÓN:</span> <span id="lbl-generation">I (KANTO)</span></div>
                </div>
                <div class="description-box">
                    <span id="poke-description">Cargando descripción...</span>
                </div>
            </div>
        </aside>

        <main class="pokemon-grid-container">
            <h2 class="grid-header"><span id="grid-title">Registro Nacional del 1 al 1025</span> <span id="loading-status">Sincronizando...</span></h2>
            <div id="grid-list" class="pokemon-grid"></div>
        </main>

    </div>

    <footer>
        &copy; 2026 PokéWeb Pro - Sistema Multimedia Multilingüe Internacional.
    </footer>

    <script>
        const TOTAL_POKEMON = 1025;
        let currentLang = 'es';
        let isShinyMode = false;
        let isRegionalMode = false;
        let selectedGender = 'male'; 
        let currentPokemonId = 1;
        let rawPokemonName = 'bulbasaur';
        let detectedRegionName = ''; // Almacena el sufijo de la región ("Alola", "Galar", etc.)

        let cachedSprites = null; 
        let regionalSprites = null;
        let baseTypes = "";
        let regionalTypes = "";
        
        let cachedBaseDescriptions = { male: '', female: '' }; 
        let cachedRegionalDescriptions = { male: '', female: '' }; 

        // Diccionario de Traducción de la interfaz
        const i18n = {
            es: { search: "Buscar por nombre o ID...", title: "Base de Datos Pokémon", defTitle: "🔴 ¿Qué es una Pokédex?", defDesc: "La Pokédex es una enciclopedia electrónica portátil e inteligente...", type: "TIPO:", alt: "ALT:", peso: "PESO:", gen: "GENERACIÓN:", sync: "Sincronizando...", online: "Online • 1025 Registros", regTitle: "Registro Nacional del 1 al 1025", male: "♂ Macho", female: "♀ Hembra", regionText: "de" },
            en: { search: "Search by name or ID...", title: "Pokémon Database", defTitle: "🔴 What is a Pokédex?", defDesc: "The Pokédex is a handheld electronic encyclopedia programmed to log data...", type: "TYPE:", alt: "HT:", peso: "WT:", gen: "GENERATION:", sync: "Syncing...", online: "Online • 1025 Records", regTitle: "National Register 1 to 1025", male: "♂ Male", female: "♀ Female", regionText: "of" },
            fr: { search: "Rechercher par nom ou ID...", title: "Base de données Pokémon", defTitle: "🔴 Qu'est-ce qu'un Pokédex?", defDesc: "Le Pokédex est une encyclopédie électronique portable qui enregistre...", type: "TYPE:", alt: "TAILLE:", peso: "POIDS:", gen: "GÉNÉRATION:", sync: "Synchronisation...", online: "En ligne • 1025 Entrées", regTitle: "Registre National 1 à 1025", male: "♂ Mâle", female: "♀ Femelle", regionText: "de" },
            de: { search: "Suche nach Name oder ID...", title: "Pokémon-Datenbank", defTitle: "🔴 Was ist ein Pokédex?", defDesc: "Der Pokédex ist ein elektronisches Lexikon, das Daten über Pokémon sammelt...", type: "TYP:", alt: "GRÖSSE:", peso: "GEWICHT:", gen: "GENERATION:", sync: "Synchronisieren...", online: "Online • 1025 Einträge", regTitle: "Nationaler Register 1 bis 1025", male: "♂ Männlich", female: "♀ Weiblich", regionText: "aus" },
            ja: { search: "名前またはIDで検索...", title: "ポケモンデータベース", defTitle: "🔴 ポケモン図鑑とは？", defDesc: "ポケモンずかんは、見つけたり捕まえたりしたポケモンの情報が自動的に記録される...", type: "タイプ:", alt: "たかさ:", peso: "おもさ:", gen: "しだい:", sync: "同期中...", online: "オンライン • 1025 登録", regTitle: "全国図鑑 1~1025", male: "♂ オス", female: "♀ メス", regionText: "の" }
        };

        const searchInput = document.getElementById('search-input');
        const langSelect = document.getElementById('lang-select');
        const pokeName = document.getElementById('poke-name');
        const pokeImg = document.getElementById('poke-img');
        const lblType = document.getElementById('lbl-type');
        const lblId = document.getElementById('lbl-id');
        const lblHeight = document.getElementById('lbl-height');
        const lblWeight = document.getElementById('lbl-weight');
        const lblGeneration = document.getElementById('lbl-generation');
        const pokeDescription = document.getElementById('poke-description');
        const gridList = document.getElementById('grid-list');
        const shinyToggle = document.getElementById('shiny-toggle');
        const regionalToggle = document.getElementById('regional-toggle');
        const btnMale = document.getElementById('btn-male');
        const btnFemale = document.getElementById('btn-female');
        const shinyStars = document.getElementById('shiny-stars');
        const loadingStatus = document.getElementById('loading-status');

        function translateUI() {
            const t = i18n[currentLang];
            searchInput.placeholder = t.search;
            document.getElementById('main-title').textContent = t.title;
            document.getElementById('def-title').textContent = t.defTitle;
            document.getElementById('lbl-t-type').textContent = t.type;
            document.getElementById('lbl-t-height').textContent = t.alt;
            document.getElementById('lbl-t-weight').textContent = t.peso;
            document.getElementById('lbl-t-gen').textContent = t.gen;
            document.getElementById('grid-title').textContent = t.regTitle;
            btnMale.childNodes[0].textContent = t.male;
            btnFemale.childNodes[0].textContent = t.female;
            updatePokemonTitle();
        }

        function getGenerationString(id) {
            if (id <= 151) return "I (KANTO)";
            if (id <= 251) return "II (JOHTO)";
            if (id <= 386) return "III (HOENN)";
            if (id <= 493) return "IV (SINNOH)";
            if (id <= 649) return "V (TESELIA)";
            if (id <= 721) return "VI (KALOS)";
            if (id <= 809) return "VII (ALOLA)";
            if (id <= 898) return "VIII (GALAR)";
            if (id <= 1025) return "IX (PALDEA)";
            return "DESCONOCIDA";
        }

        function updatePokemonTitle() {
            let localizedName = rawPokemonName;
            if(isRegionalMode && detectedRegionName) {
                const connector = i18n[currentLang].regionText;
                pokeName.textContent = `${localizedName} ${connector} ${detectedRegionName} N°.${currentPokemonId.toString().padStart(3, '0')}`;
            } else {
                pokeName.textContent = `${localizedName} N°.${currentPokemonId.toString().padStart(3, '0')}`;
            }
        }

        function updatePokedexImage() {
            if (currentPokemonId === 1017) { 
                pokeImg.src = isShinyMode 
                    ? `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/shiny/variants/1017-teal-mask.png`
                    : `https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/1017.png`;
                return;
            }

            let activeSprites = (isRegionalMode && regionalSprites) ? regionalSprites : cachedSprites;
            if (!activeSprites) return;

            let finalUrl = activeSprites.front_default;

            if (isShinyMode) {
                finalUrl = (selectedGender === 'female' && activeSprites.front_shiny_female) 
                    ? activeSprites.front_shiny_female : activeSprites.front_shiny;
            } else {
                finalUrl = (selectedGender === 'female' && activeSprites.front_female) 
                    ? activeSprites.front_female : activeSprites.front_default;
            }
            pokeImg.src = finalUrl || activeSprites.front_default;
            lblType.textContent = isRegionalMode ? regionalTypes : baseTypes;
            updatePokemonTitle();
        }

        function updateDescriptionText() {
            let source = isRegionalMode ? cachedRegionalDescriptions : cachedBaseDescriptions;
            pokeDescription.textContent = selectedGender === 'female' ? source.female : source.male;
        }

        langSelect.addEventListener('change', (e) => {
            currentLang = e.target.value;
            translateUI();
            loadPokedexData(currentPokemonId);
        });

        shinyToggle.addEventListener('click', () => {
            isShinyMode = !isShinyMode;
            shinyToggle.classList.toggle('active-shiny', isShinyMode);
            shinyStars.style.display = isShinyMode ? 'block' : 'none';
            updatePokedexImage();
        });

        regionalToggle.addEventListener('click', () => {
            isRegionalMode = !isRegionalMode;
            regionalToggle.classList.toggle('active-regional', isRegionalMode);
            updatePokedexImage();
            updateDescriptionText();
        });

        btnMale.addEventListener('click', () => {
            selectedGender = 'male';
            btnMale.classList.add('active-male');
            btnFemale.classList.remove('active-female');
            updatePokedexImage();
            updateDescriptionText();
        });

        btnFemale.addEventListener('click', () => {
            selectedGender = 'female';
            btnFemale.classList.add('active-female');
            btnMale.classList.remove('active-male');
            updatePokedexImage();
            updateDescriptionText();
        });

        async function loadPokedexData(idOrName) {
            try {
                isRegionalMode = false;
                regionalToggle.classList.remove('active-regional');
                regionalSprites = null;
                regionalToggle.disabled = true;
                detectedRegionName = '';

                // 1. Cargar Datos Base
                const response = await fetch(`https://pokeapi.co/api/v2/pokemon/${idOrName.toString().toLowerCase()}`);
                if(!response.ok) return;
                const data = await response.json();

                currentPokemonId = data.id;
                cachedSprites = data.sprites;
                rawPokemonName = data.name;
                
                lblId.textContent = `#${data.id.toString().padStart(3, '0')}`;
                baseTypes = data.types.map(t => t.type.name.toUpperCase()).join('/');
                lblType.textContent = baseTypes;
                lblHeight.textContent = `${(data.height / 10).toFixed(1)} m`;
                lblWeight.textContent = `${(data.weight / 10).toFixed(1)} kg`;
                lblGeneration.textContent = getGenerationString(data.id);

                // 2. Comprobar Formas Regionales y extraer su Info textuall
                try {
                    const speciesResponseForForms = await fetch(`https://pokeapi.co/api/v2/pokemon-species/${currentPokemonId}/`);
                    if(speciesResponseForForms.ok) {
                        const sData = await speciesResponseForForms.json();
                        if(sData.varieties && sData.varieties.length > 1) {
                            const regionalVariety = sData.varieties.find(v => 
                                v.pokemon.name.includes('-alola') || 
                                v.pokemon.name.includes('-galar') || 
                                v.pokemon.name.includes('-hisui') || 
                                v.pokemon.name.includes('-paldea')
                            );
                            if(regionalVariety) {
                                // Guardar el nombre de la region con la primera letra Mayuscula
                                const match = regionalVariety.pokemon.name.match(/-(alola|galar|hisui|paldea)/);
                                if(match) detectedRegionName = match[1].charAt(0).toUpperCase() + match[1].slice(1);
                                
                                const regRes = await fetch(regionalVariety.pokemon.url);
                                if(regRes.ok) {
                                    const regData = await regRes.json();
                                    regionalSprites = regData.sprites;
                                    regionalTypes = regData.types.map(t => t.type.name.toUpperCase()).join('/');
                                    regionalToggle.disabled = false;
                                }
                            }
                        }
                    }
                } catch(err) { console.log("Sin variantes regionales."); }

                // 3. Obtener Descripciones en base al Idioma Seleccionado
                const speciesResponse = await fetch(`https://pokeapi.co/api/v2/pokemon-species/${currentPokemonId}/`);
                if (speciesResponse.ok) {
                    const speciesData = await speciesResponse.json();
                    const genderRate = speciesData.gender_rate;

                    // Bloqueos de Género
                    if (genderRate === -1) {
                        btnMale.disabled = true; btnFemale.disabled = true;
                        btnMale.classList.remove('active-male'); btnFemale.classList.remove('active-female');
                    } else if (genderRate === 8) {
                        selectedGender = 'female'; btnFemale.disabled = false; btnMale.disabled = true;
                        btnFemale.classList.add('active-female'); btnMale.classList.remove('active-male');
                    } else if (genderRate === 0) {
                        selectedGender = 'male'; btnMale.disabled = false; btnFemale.disabled = true;
                        btnMale.classList.add('active-male'); btnFemale.classList.remove('active-female');
                    } else {
                        btnMale.disabled = false; btnFemale.disabled = false;
                        if (selectedGender === 'male') {
                            btnMale.classList.add('active-male'); btnFemale.classList.remove('active-female');
                        } else {
                            btnFemale.classList.add('active-female'); btnMale.classList.remove('active-male');
                        }
                    }

                    // Filtrar entradas por idioma actual de la app
                    const matchedEntries = speciesData.flavor_text_entries.filter(entry => entry.language.name === currentLang);
                    
                    if (matchedEntries.length > 0) {
                        const primaryText = matchedEntries[0].flavor_text.replace(/[\n\f]/g, ' ');
                        const secondaryText = matchedEntries[1] ? matchedEntries[1].flavor_text.replace(/[\n\f]/g, ' ') : primaryText;
                        
                        // Si está activada la variante regional usamos textos lejanos si existen
                        cachedBaseDescriptions.male = primaryText;
                        cachedBaseDescriptions.female = secondaryText;

                        // Simulador de descripción regional cruzada
                        cachedRegionalDescriptions.male = matchedEntries[matchedEntries.length - 1] ? matchedEntries[matchedEntries.length - 1].flavor_text.replace(/[\n\f]/g, ' ') : primaryText;
                        cachedRegionalDescriptions.female = matchedEntries[matchedEntries.length - 2] ? matchedEntries[matchedEntries.length - 2].flavor_text.replace(/[\n\f]/g, ' ') : secondaryText;
                    } else {
                        const fallbackText = "No data available in this language.";
                        cachedBaseDescriptions.male = fallbackText; cachedBaseDescriptions.female = fallbackText;
                        cachedRegionalDescriptions.male = fallbackText; cachedRegionalDescriptions.female = fallbackText;
                    }
                }

                updatePokedexImage();
                updateDescriptionText();

            } catch (error) {
                console.error(error);
            }
        }

        function generate1025Grid() {
            const fragment = document.createDocumentFragment();
            for (let i = 1; i <= TOTAL_POKEMON; i++) {
                const card = document.createElement('div');
                card.classList.add('poke-card');
                card.setAttribute('data-id', i);
                
                card.innerHTML = `
                    <p>#${i.toString().padStart(3, '0')}</p>
                    <img src="https://raw.githubusercontent.com/PokeAPI/sprites/master/sprites/pokemon/${i}.png" data-id="${i}" alt="pkmn" loading="lazy">
                    <h3 id="n-${i}">N°. ${i}</h3>
                `;
                
                card.addEventListener('click', () => loadPokedexData(i));
                fragment.appendChild(card);
            }
            gridList.appendChild(fragment);
            fetchAllNames();
        }

        async function fetchAllNames() {
            try {
                const res = await fetch(`https://pokeapi.co/api/v2/pokemon?limit=${TOTAL_POKEMON}`);
                const data = await res.json();
                data.results.forEach((pkmn, index) => {
                    const id = index + 1;
                    const h3El = document.getElementById(`n-${id}`);
                    if(h3El) {
                        h3El.textContent = pkmn.name;
                        h3El.parentElement.setAttribute('data-search-name', pkmn.name);
                    }
                });
                loadingStatus.textContent = i18n[currentLang].online;
            } catch (e) {
                loadingStatus.textContent = "Error.";
            }
        }

        searchInput.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            if(query.length > 2) loadPokedexData(query);

            const cards = document.querySelectorAll('.poke-card');
            cards.forEach(card => {
                const nameAttr = card.getAttribute('data-search-name') || '';
                const idAttr = card.getAttribute('data-id');
                if(nameAttr.includes(query) || idAttr === query) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });

        translateUI();
        generate1025Grid();
        loadPokedexData(1);
    </script>
</body>
</html>
